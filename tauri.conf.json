{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameReady",
  "version": "0.1.1",
  "identifier": "com.gameready.app",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GameReady",
        "width": 480,
        "height": 660,
        "minWidth": 480,
        "minHeight": 660,
        "resizable": false,
        "decorations": false,
        "center": true,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
